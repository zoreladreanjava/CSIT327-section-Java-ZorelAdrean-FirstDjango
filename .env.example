# Optional: without a .env the app runs on a random key and logs everyone out on
# each restart. To keep a fixed key, copy this file to .env and use a key from:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Keep the single quotes: generated keys can contain characters like # and $.
SECRET_KEY='replace-me'
